# ============================================================
# DrishtiAI Environment Configuration
# ============================================================

# Backend API Configuration
# Optional: Set this to your Python/Flask/FastAPI/TensorFlow DR inference endpoint.
# If omitted or unreachable, DrishtiAI automatically operates in Mock Mode for instant demoing.
REACT_APP_API_URL=http://localhost:8000/api

# Firebase v10 Configuration (Google Authentication & Firestore)
# Optional: Provide your Firebase project credentials.
# If any of these are missing, DrishtiAI automatically activates Demo Mode with local mock state.
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id
