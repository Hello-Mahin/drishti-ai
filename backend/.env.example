# DrishtiAI Backend Environment Configuration

# Gemini API Key (Get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Firebase Admin SDK Credentials
# Local testing: path to serviceAccountKey.json downloaded from Firebase Console
# Cloud Run: Leave empty if using Cloud Run Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

# Model weights path (default: efficientnet_dr.pth in root directory)
MODEL_PATH=efficientnet_dr.pth

# Server Port (Cloud Run dynamically sets this to 8080)
PORT=8080
